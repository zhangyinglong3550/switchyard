{
  "name": "switchyard",
  "version": "2.2.40",
  "description": "Local multi-client LLM gateway and desktop control panel for Codex, Claude Code, Hermes, OpenCode, Grok Build and other OpenAI-compatible / Anthropic-compatible tools. Includes multi-account OAuth pools (Grok / Codex) and Anthropic official OAuth.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangyinglong3550/switchyard.git"
  },
  "bugs": {
    "url": "https://github.com/zhangyinglong3550/switchyard/issues"
  },
  "homepage": "https://github.com/zhangyinglong3550/switchyard#readme",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gateway": "node packages/core/bin/gateway.mjs start",
    "gateway:init": "node packages/core/bin/gateway.mjs init",
    "gateway:doctor": "node packages/core/bin/gateway.mjs doctor",
    "gateway:models": "node packages/core/bin/gateway.mjs models",
    "test": "node --test packages/core/test/*.mjs",
    "precheck": "node --check apps/desktop/src/mobile-control/approval-policy.mjs && node --check apps/desktop/src/mobile-control/command-catalog.mjs",
  "check": "node -e \"['packages/core/src/config.mjs','packages/core/src/router.mjs','packages/core/src/upstream.mjs','packages/core/src/utils.mjs','packages/core/src/server.mjs','packages/core/src/request-kind.mjs','packages/core/src/model-directory-sync.mjs','packages/core/src/openai-adapter.mjs','packages/core/src/openai-adapter-out.mjs','packages/core/src/anthropic-adapter.mjs','packages/core/src/antigravity-adapter.mjs','packages/core/src/opencode-text-tool-calls.mjs','packages/core/src/sse-parser.mjs','packages/core/src/stream-idle-timeout.mjs','packages/core/src/stream-keepalive.mjs','packages/core/src/importers/sub2api-data.mjs','packages/core/src/account-pool/agent-identity.mjs','packages/core/src/account-pool/import-sub2api.mjs','packages/core/src/profile-writer.mjs','packages/core/src/history-unify.mjs','packages/core/src/keychain-store.mjs','packages/core/src/balance-check.mjs','packages/core/src/usage-template-types.mjs','packages/core/src/cursor-subscription/auth.mjs','packages/core/src/cursor-subscription/model-catalog.mjs','packages/core/src/cursor-subscription/rate-limit.mjs','packages/core/src/cursor-subscription/adapter.mjs','packages/core/src/cursor-subscription/client.mjs','packages/core/src/compat/index.mjs','packages/core/src/compat/registry.mjs','packages/core/src/compat/matcher.mjs','packages/core/src/compat/packs.mjs','packages/core/src/compat/fixture-runner.mjs','packages/core/src/compat/patches/opencode-glm-no-tools.mjs','packages/core/bin/gateway.mjs','apps/desktop/src/main.mjs','apps/desktop/src/preload.cjs','apps/desktop/src/gateway-host.mjs','apps/desktop/src/config-store.mjs','apps/desktop/src/logs.mjs','apps/desktop/src/request-log-store.mjs','apps/desktop/src/session-titles-store.mjs','apps/desktop/src/agent-resources.mjs','apps/desktop/src/agent-plugins.mjs','apps/desktop/src/codex-app-server.mjs','apps/desktop/src/session-handoff.mjs','apps/desktop/src/keychain-store.mjs','apps/desktop/src/diagnostics.mjs','apps/desktop/src/issue-bundle.mjs','apps/desktop/src/provider-health.mjs','apps/desktop/src/test-console.mjs','apps/desktop/src/mobile-control-host.mjs','apps/desktop/src/mobile-control/store.mjs','apps/desktop/src/mobile-control/dto.mjs','apps/desktop/src/mobile-control/event-ledger.mjs','apps/desktop/src/mobile-control/acp-client.mjs','apps/desktop/src/mobile-control/acp-runtime.mjs','apps/desktop/src/mobile-control/temp-attachments.mjs','apps/desktop/src/mobile-control/codex-runtime.mjs','apps/desktop/src/mobile-control/claude-runtime.mjs','apps/desktop/src/mobile-control/grok-runtime.mjs','apps/desktop/src/mobile-control/opencode-runtime.mjs','apps/desktop/src/mobile-control/session-registry.mjs','apps/desktop/src/mobile-control/server.mjs','apps/mobile/app.js','apps/mobile/sw.js','apps/desktop/renderer/renderer.js','apps/desktop/renderer/client-visibility-utils.mjs','apps/desktop/renderer/discovery-filter.mjs','apps/desktop/renderer/import-selection-utils.mjs','apps/desktop/renderer/model-form-utils.mjs'].forEach(p=>require('child_process').execSync('node --check '+p,{stdio:'inherit'}))\"",
    "desktop": "electron apps/desktop/src/main.mjs",
    "desktop:dev": "electron apps/desktop/src/main.mjs",
    "desktop:dmg": "electron-builder --mac dmg",
    "desktop:win": "electron-builder --win nsis zip --x64",
    "release:check": "node scripts/release-check.mjs",
    "import:ccswitch": "node scripts/import-ccswitch.mjs",
    "android:release:check": "bash apps/android/scripts/verify-release.sh"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zhangyinglong.switchyard",
    "productName": "Switchyard",
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "en-US",
      "en_US",
      "zh",
      "zh-CN",
      "zh_CN",
      "zh-TW",
      "zh_TW",
      "zh-Hans",
      "zh-Hant"
    ],
    "files": [
      "package.json",
      "apps/desktop/**/*",
      "apps/mobile/**/*",
      "packages/core/**/*",
      "config/**/*",
      "!**/*.map",
      "!**/test/**",
      "!**/*.{md,markdown,ts,tsx,cts,mts}",
      "!**/README*",
      "!**/CHANGELOG*",
      "!**/LICENSE*",
      "!**/docs/**",
      "!**/example/**",
      "!**/examples/**",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/build/Release/obj/**",
      "!node_modules/better-sqlite3/build/Release/.deps/**",
      "!node_modules/better-sqlite3/build/Release/*.a",
      "!node_modules/better-sqlite3/build/Release/*.o",
      "!node_modules/undici/docs/**",
      "!node_modules/undici/types/**",
      "!node_modules/undici/scripts/**",
      "!node_modules/**/{.github,test,tests,__tests__,powered-test}/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "afterPack": "./scripts/after-pack-sign.mjs",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "apps/desktop/assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    },
    "win": {
      "icon": "apps/desktop/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "resources/win/sqlite3.exe",
          "to": "win/sqlite3.exe",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraMetadata": {
      "main": "apps/desktop/src/main.mjs"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "main": "apps/desktop/src/main.mjs",
  "author": {
    "name": "Switchyard Team",
    "email": "zhangyinglong3550@gmail.com"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "better-sqlite3": "^12.11.1",
    "undici": "^6.27.0"
  }
}
